# ─── Site ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.threadswears.com

# ─── Auth (REQUIRED in production — 32+ random chars) ────
AUTH_SECRET=replace-with-a-long-random-string

# ─── Admin (comma-separated emails allowed into /admin) ──
# Admin sign-in at /admin/login (separate from customer accounts). Use a long, unique password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Supabase client (browser-safe publishable key) ──────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─── Database (server only — NEVER prefix with NEXT_PUBLIC_) ─────────────
# With the secret key set, all store data lives in Supabase (run supabase/schema.sql first).
# Without it, data is kept in a local JSON file in .data/ (fine for development, not for Vercel).
SUPABASE_SECRET_KEY=

# ─── Payments (leave blank to use the built-in sandbox gateway) ─
PAYMENT_PROVIDER=sandbox            # sandbox | razorpay | stripe
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Analytics (loaded only after cookie consent) ─────────
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ─── Email marketing ─────────────────────────────────────
EMAIL_PROVIDER_API_KEY=
