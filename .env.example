# ─── Site ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.threadsware.in

# ─── Auth (REQUIRED in production — 32+ random chars) ────
AUTH_SECRET=replace-with-a-long-random-string

# ─── Supabase client (browser-safe publishable key) ──────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─── Database (optional — falls back to local JSON store in .data/) ─
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Payments (leave blank to use the built-in sandbox gateway) ─
PAYMENT_PROVIDER=sandbox            # sandbox | razorpay | stripe
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Analytics (loaded only after cookie consent) ─────────
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ─── Email marketing ─────────────────────────────────────
EMAIL_PROVIDER_API_KEY=
